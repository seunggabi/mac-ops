#!/bin/zsh
# =============================================================================
# mac-ops: macOS optimization CLI tool
# Main entry point
# =============================================================================

setopt ERR_EXIT PIPE_FAIL

# --- Ensure system PATH ---
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin"

# --- Root path based on script location ---
MAC_OPS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# --- Module loading ---
source "${MAC_OPS_ROOT}/lib/core/config.zsh"
source "${MAC_OPS_ROOT}/lib/core/logger.zsh"
source "${MAC_OPS_ROOT}/lib/core/lock.zsh"
source "${MAC_OPS_ROOT}/lib/core/run.zsh"
source "${MAC_OPS_ROOT}/lib/core/trash.zsh"
source "${MAC_OPS_ROOT}/lib/core/safety.zsh"
source "${MAC_OPS_ROOT}/lib/core/ignore.zsh"
source "${MAC_OPS_ROOT}/lib/core/disk.zsh"
source "${MAC_OPS_ROOT}/lib/core/dispatch.zsh"
source "${MAC_OPS_ROOT}/lib/utils/plist-helper.zsh"
source "${MAC_OPS_ROOT}/lib/utils/format.zsh"
source "${MAC_OPS_ROOT}/lib/utils/parallel.zsh"
source "${MAC_OPS_ROOT}/lib/utils/notify.zsh"
source "${MAC_OPS_ROOT}/lib/utils/snapshot.zsh"
source "${MAC_OPS_ROOT}/lib/utils/security-keywords.zsh"
source "${MAC_OPS_ROOT}/lib/utils/running.zsh"
source "${MAC_OPS_ROOT}/lib/modules/cache-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/tmp-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/log-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/zombie-killer.zsh"
source "${MAC_OPS_ROOT}/lib/modules/orphan-killer.zsh"
source "${MAC_OPS_ROOT}/lib/modules/orphan-app-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/brew-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/dev-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/docker-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/browser-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/analyze.zsh"
source "${MAC_OPS_ROOT}/lib/modules/monitor.zsh"

# --- Version (from git tag or VERSION file) ---
if [[ -d "${MAC_OPS_ROOT}/.git" ]]; then
  # Development mode: use git tag
  MAC_OPS_VERSION=$(git -C "${MAC_OPS_ROOT}" describe --tags --abbrev=0 2>/dev/null || echo "unknown")
  MAC_OPS_VERSION="${MAC_OPS_VERSION#v}"
elif [[ -f "${MAC_OPS_ROOT}/VERSION" ]]; then
  # Installed mode: use VERSION file
  MAC_OPS_VERSION=$(cat "${MAC_OPS_ROOT}/VERSION")
else
  MAC_OPS_VERSION="unknown"
fi

# =============================================================================
# Help
# =============================================================================
_mac_ops_show_help() {
  cat <<'HELP'
mac-ops - macOS optimization CLI tool

Usage:
  mac-ops [command] [options]

Commands:
  run              Run cleanup (default command)
  analyze          Disk space analysis report
  monitor          Memory & CPU usage dashboard (7-day history)
  monitor --hours  Show hourly sparkline view
  monitor top [N]  Show top N processes by memory (default: 10)
  monitor kill [M] Kill processes using more than M MB (default: 500)
  monitor collect  Record a snapshot (use for scheduled collection)
  monitor setup    Install launchd agent (collect every 5 min)
  monitor unsetup  Uninstall launchd agent
  status           Show health (last run, its exit status, errors, warnings,
                   data items moved, agents loaded/overdue), trash and disk
  restore <path>   Restore from trash to original location
  restore --run <run-id>
                   Restore every item of one run that is still in the trash
                   (refuses items whose original location exists again)
  runs             List recent runs (time, exit status, items, data items)
  list-trash       List trash contents
  purge            Purge expired trash items immediately
  install          Install launchd agent
  uninstall        Uninstall launchd agent
  config           Show current configuration
  help             Show help
  version          Show version

Options:
  --dry-run        Preview without actual execution
  --module=NAME    Run specific module only
  --verbose        Verbose log output
  --force          Ignore size guard
  --scheduled      Internal flag when run from launchd

Available modules:
  cache, tmp, log, zombie, orphan, orphan-app, brew, dev, docker, browser
  A plain run only runs modules enabled in config.plist (Modules.<name>.Enabled)
  or by MAC_OPS_MODULE_<NAME>_ENABLED=true. Enabled by default: cache, tmp, log,
  orphan-app. --module=NAME runs that module even when it is disabled.
HELP
}

# =============================================================================
# version
# =============================================================================
_mac_ops_show_version() {
  print "mac-ops v${MAC_OPS_VERSION}"
}

# =============================================================================
# run command
# =============================================================================
_mac_ops_cmd_run() {
  local target_module="${1:-}"

  # 1. Initialize directories
  mac_ops_init_dirs

  # 2. Run ID, start time and log position. From here every exit path ends in
  #    mac_ops_run_finish: the returns below, ERR_EXIT and INT/TERM/HUP
  mac_ops_run_start
  mac_ops_setup_trap

  # 3. Load configuration
  if ! mac_ops_load_config; then
    mac_ops_run_finish 1
    return 1
  fi

  # 4. Log rotation
  mac_ops_log_rotate
  mac_ops_log_line_count; MAC_OPS_RUN_LOG_START="${REPLY}"

  # 5. Acquire lock - exit on failure (held until mac_ops_run_finish)
  if ! mac_ops_acquire_lock; then
    mac_ops_log_error "Another mac-ops instance is already running. Exiting."
    mac_ops_run_finish 1
    return 1
  fi
  _MAC_OPS_RUN_LOCKED=true

  # 6. Emergency purge on disk danger
  mac_ops_emergency_purge || true

  # 7. Take before snapshot
  local snapshot_before
  snapshot_before=$(mac_ops_take_snapshot)

  # 8. Initialize global counters
  MAC_OPS_CLEANED_COUNT=0
  MAC_OPS_CLEANED_BYTES=0
  MAC_OPS_KILLED_COUNT=0
  MAC_OPS_DATA_MOVED_COUNT=0

  # Temporary directory for statistics collection (removed by mac_ops_run_finish)
  MAC_OPS_RUN_STATS_DIR="${MAC_OPS_HOME}/.tmp/stats_$$"
  mkdir -p "${MAC_OPS_RUN_STATS_DIR}" 2>/dev/null

  # 9. Load user ignore rules (before any module runs)
  mac_ops_ignore_load

  # 10. Module execution (enabled modules only; --module runs one explicitly)
  if ! mac_ops_run_modules "${target_module}" "${MAC_OPS_RUN_STATS_DIR}"; then
    mac_ops_run_finish 1
    return 1
  fi

  # 11. Delete expired files (72 hour threshold)
  mac_ops_trash_expire || true

  # 12. Take after snapshot
  local snapshot_after
  snapshot_after=$(mac_ops_take_snapshot)

  # 13. System report (before/after comparison + cleanup summary)
  mac_ops_print_report "${snapshot_before}" "${snapshot_after}" "${MAC_OPS_CLEANED_COUNT}" "${MAC_OPS_CLEANED_BYTES}" "${MAC_OPS_KILLED_COUNT}" "${MAC_OPS_DATA_MOVED_COUNT}"

  # 14. Release lock, macOS notification (scheduled mode; also when ERRORs
  #     were logged). Free bytes (df -k) are the second snapshot field
  local before_free after_free _pct _rest
  read -r _pct before_free _rest <<< "${snapshot_before}"
  read -r _pct after_free _rest <<< "${snapshot_after}"
  mac_ops_run_finish 0 "${before_free}" "${after_free}"
}

# =============================================================================
# status command
# =============================================================================
_mac_ops_cmd_status() {
  # Read-only: no directory creation, no index write, no migration
  mac_ops_load_config || return 1

  # Health first: a failed or overdue scheduled run is the first line
  mac_ops_run_health

  print ""

  # Trash status
  mac_ops_trash_status

  print ""

  # Disk usage
  local disk_usage disk_available
  disk_usage=$(mac_ops_get_disk_usage) || disk_usage="N/A"
  disk_available=$(mac_ops_get_disk_available) || disk_available="0"

  local available_human
  available_human=$(mac_ops_format_bytes "${disk_available}")

  print "=== Disk Status ==="
  print "Usage:           ${disk_usage}%"
  print "Available space: ${available_human}"

  print ""

  # launchd agent plists (loaded state is in the health section)
  print "=== launchd Agent ==="
  _mac_ops_report_agents
}

# =============================================================================
# restore command
# =============================================================================
_mac_ops_cmd_restore() {
  local restore_path="${1:-}"
  local run_id="${2:-}"

  if [[ -z "${restore_path}" && -z "${run_id}" ]]; then
    mac_ops_log_error "Usage: mac-ops restore <path> | mac-ops restore --run <run-id>"
    return 1
  fi

  mac_ops_load_config || return 1
  if [[ "${MAC_OPS_DRY_RUN}" != "true" ]]; then
    mac_ops_init_dirs
  fi
  if [[ -n "${run_id}" ]]; then
    mac_ops_trash_restore_run "${run_id}"
  else
    mac_ops_trash_restore "${restore_path}"
  fi
}

# =============================================================================
# runs command
# =============================================================================
_mac_ops_cmd_runs() {
  # Read-only: no directory creation
  mac_ops_load_config || return 1
  mac_ops_runs_list "${1:-20}"
}

# =============================================================================
# list-trash command
# =============================================================================
_mac_ops_cmd_list_trash() {
  # Read-only: no directory creation, no index write, no migration
  mac_ops_load_config || return 1
  mac_ops_trash_list
}

# =============================================================================
# purge command
# =============================================================================
_mac_ops_cmd_purge() {
  mac_ops_load_config || return 1
  if [[ "${MAC_OPS_DRY_RUN}" != "true" ]]; then
    mac_ops_init_dirs
  fi
  mac_ops_trash_expire
}

# =============================================================================
# launchd agent helpers
# =============================================================================

# -----------------------------------------------------------------------------
# Path of the mac-ops executable to write into a launchd plist.
# Usage: _mac_ops_agent_bin_path [resolved_script_path]
#
# A Homebrew install runs from <prefix>/Cellar/<formula>/<version>/libexec/...,
# and that directory is deleted by "brew upgrade". An agent registered with it
# keeps failing silently after the upgrade. When the script lives in a Cellar,
# use the version-independent <prefix>/opt/<formula>/... path instead (or the
# <prefix>/bin/mac-ops wrapper). Any other install keeps the resolved path.
# -----------------------------------------------------------------------------
_mac_ops_agent_bin_path() {
  local resolved="${1:-${MAC_OPS_ROOT}/bin/mac-ops}"

  if [[ "${resolved}" == */Cellar/*/*/libexec/bin/mac-ops ]]; then
    local prefix="${resolved%%/Cellar/*}"
    local rest="${resolved#*/Cellar/}"
    local formula="${rest%%/*}"
    local stable="${prefix}/opt/${formula}/libexec/bin/mac-ops"
    local wrapper="${prefix}/bin/mac-ops"

    if [[ -x "${stable}" ]]; then
      print -r -- "${stable}"
      return 0
    fi
    if [[ -x "${wrapper}" ]]; then
      print -r -- "${wrapper}"
      return 0
    fi
  fi

  print -r -- "${resolved}"
  return 0
}

# -----------------------------------------------------------------------------
# Render a launchd plist template and (re)register the agent.
# Usage: _mac_ops_install_agent <template_name>
# Sets REPLY to the executable path written into the plist.
# -----------------------------------------------------------------------------
_mac_ops_install_agent() {
  local plist_name="${1}"
  local plist_src="${MAC_OPS_ROOT}/launchd/${plist_name}"
  local plist_dst="${HOME}/Library/LaunchAgents/${plist_name}"
  local home_path="${HOME}/.mac-ops"
  local bin_path
  bin_path=$(_mac_ops_agent_bin_path)

  if [[ ! -f "${plist_src}" ]]; then
    mac_ops_log_error "plist template not found: ${plist_src}"
    return 1
  fi

  if [[ "${MAC_OPS_DRY_RUN}" == "true" ]]; then
    mac_ops_log_info "[DRY_RUN] Will write ${plist_dst} (runs ${bin_path}) and load it with launchctl"
    REPLY="${bin_path}"
    return 0
  fi

  # 1. Ensure LaunchAgents directory
  mkdir -p "${HOME}/Library/LaunchAgents" 2>/dev/null || true

  # 2. Unload a previously registered agent first: launchd keeps the old
  #    definition (and its old executable path) if the label is still loaded
  if [[ -f "${plist_dst}" ]]; then
    launchctl unload "${plist_dst}" 2>/dev/null || true
  fi

  # 3. Copy plist and replace placeholders
  sed -e "s|REPLACEME_MAC_OPS_BIN|${bin_path}|g" \
      -e "s|REPLACEME_MAC_OPS_HOME|${home_path}|g" \
      "${plist_src}" > "${plist_dst}"

  # 4. launchctl load
  launchctl load "${plist_dst}" 2>/dev/null || true

  REPLY="${bin_path}"
  return 0
}

# -----------------------------------------------------------------------------
# Report installed agent plists and whether their executable is usable:
# BROKEN when the program path is unreadable or does not exist, STALE when it
# is a versioned Homebrew Cellar path (deleted by the next "brew upgrade").
# Read-only. Usage: _mac_ops_report_agents [launch_agents_dir]
# -----------------------------------------------------------------------------
_mac_ops_report_agents() {
  local agent_dir="${1:-${HOME}/Library/LaunchAgents}"
  local label fix_cmd plist target
  local found=0

  for label in cleanup monitor; do
    plist="${agent_dir}/com.mac-ops.${label}.plist"
    [[ -f "${plist}" ]] || continue
    found=$((found + 1))

    if [[ "${label}" == "monitor" ]]; then
      fix_cmd="mac-ops monitor unsetup && mac-ops monitor setup"
    else
      fix_cmd="mac-ops uninstall && mac-ops install"
    fi

    target=$(plutil -extract ProgramArguments.0 raw -o - "${plist}" 2>/dev/null) || target=""

    if [[ -z "${target}" ]]; then
      print "com.mac-ops.${label}: BROKEN - cannot read the program path from ${plist}"
      print "  Fix: ${fix_cmd}"
    elif [[ ! -x "${target}" ]]; then
      print "com.mac-ops.${label}: BROKEN - plist points at a file that does not exist:"
      print "  ${target}"
      print "  The agent fails silently on every run. Fix: ${fix_cmd}"
    elif [[ "${target}" == */Cellar/* ]]; then
      print "com.mac-ops.${label}: STALE - plist points at a versioned Homebrew Cellar path:"
      print "  ${target}"
      print "  It stops working after the next 'brew upgrade mac-ops'. Fix: ${fix_cmd}"
    else
      print "com.mac-ops.${label}: OK -> ${target}"
    fi
  done

  if [[ ${found} -eq 0 ]]; then
    print "No agent plist in ${agent_dir}"
  fi
  return 0
}

# =============================================================================
# install command
# =============================================================================
_mac_ops_cmd_install() {
  if ! _mac_ops_install_agent "com.mac-ops.cleanup.plist"; then
    return 1
  fi
  local bin_path="${REPLY}"
  local plist_dst="${HOME}/Library/LaunchAgents/com.mac-ops.cleanup.plist"

  [[ "${MAC_OPS_DRY_RUN}" == "true" ]] && return 0

  mac_ops_log_info "launchd agent installed: ${plist_dst} (runs ${bin_path})"

  # FDA permission guide
  print ""
  print "========================================================"
  print " FDA (Full Disk Access) permission is required."
  print ""
  print " System Settings > Privacy & Security > Full Disk Access"
  print " Please add the following item:"
  print ""
  print "   ${bin_path}"
  print ""
  print " Without FDA permission, some cache/log paths cannot be accessed."
  print "========================================================"
}

# =============================================================================
# uninstall command
# =============================================================================
_mac_ops_cmd_uninstall() {
  local plist_path="${HOME}/Library/LaunchAgents/com.mac-ops.cleanup.plist"

  if [[ ! -f "${plist_path}" ]]; then
    mac_ops_log_warn "launchd agent is not installed."
    return 0
  fi

  if [[ "${MAC_OPS_DRY_RUN}" == "true" ]]; then
    mac_ops_log_info "[DRY_RUN] Will unload and remove ${plist_path}"
    return 0
  fi

  # 1. launchctl unload
  launchctl unload "${plist_path}" 2>/dev/null || true

  # 2. Delete plist
  rm -f "${plist_path}"

  mac_ops_log_info "launchd agent uninstalled"
}

# =============================================================================
# analyze command
# =============================================================================
_mac_ops_cmd_analyze() {
  mac_ops_init_dirs
  mac_ops_load_config || return 1
  mac_ops_analyze
}

# =============================================================================
# monitor command
# =============================================================================
_mac_ops_cmd_monitor() {
  mac_ops_init_dirs
  mac_ops_load_config || return 1

  local subcmd="${1:-show}"
  shift 2>/dev/null || true

  case "${subcmd}" in
    show|--hours|-h)
      mac_ops_monitor_show "${subcmd}"
      ;;
    top)
      mac_ops_monitor_top "${1:-10}"
      ;;
    kill)
      mac_ops_monitor_kill "${1:-${MAC_OPS_MONITOR_KILL_THRESHOLD_MB:-500}}"
      ;;
    collect)
      mac_ops_monitor_collect
      mac_ops_log_info "Monitor snapshot collected"
      ;;
    setup)
      if ! _mac_ops_install_agent "com.mac-ops.monitor.plist"; then
        return 1
      fi
      [[ "${MAC_OPS_DRY_RUN}" == "true" ]] && return 0
      mac_ops_log_info "Monitor launchd agent installed (every 5 min): ${HOME}/Library/LaunchAgents/com.mac-ops.monitor.plist (runs ${REPLY})"
      ;;
    unsetup)
      local plist_path="${HOME}/Library/LaunchAgents/com.mac-ops.monitor.plist"
      if [[ ! -f "${plist_path}" ]]; then
        mac_ops_log_warn "Monitor launchd agent is not installed."
        return 0
      fi
      if [[ "${MAC_OPS_DRY_RUN}" == "true" ]]; then
        mac_ops_log_info "[DRY_RUN] Will unload and remove ${plist_path}"
        return 0
      fi
      launchctl unload "${plist_path}" 2>/dev/null || true
      rm -f "${plist_path}"
      mac_ops_log_info "Monitor launchd agent uninstalled"
      ;;
    *)
      # treat unknown subcommand as flag to show (e.g., --hours passed first)
      mac_ops_monitor_show "${subcmd}"
      ;;
  esac
}

# =============================================================================
# config command
# =============================================================================
_mac_ops_cmd_config() {
  mac_ops_init_dirs
  mac_ops_load_config || return 1

  print "=== mac-ops Current Configuration ==="
  print "MAC_OPS_HOME                     = ${MAC_OPS_HOME}"
  print "MAC_OPS_TRASH_DIR                = ${MAC_OPS_TRASH_DIR}"
  print "MAC_OPS_META_DIR                 = ${MAC_OPS_META_DIR}"
  print "MAC_OPS_LOG_DIR                  = ${MAC_OPS_LOG_DIR}"
  print "MAC_OPS_CONFIG_FILE              = ${MAC_OPS_CONFIG_FILE}"
  print "MAC_OPS_SCHEDULED                = ${MAC_OPS_SCHEDULED}"
  print ""
  print "=== Settings (source: env > file > default; cli = command-line flag) ==="
  mac_ops_print_settings
}

# =============================================================================
# CLI parsing and main
# =============================================================================
_mac_ops_main() {
  local command="run"
  local module_name=""
  local restore_path=""
  local restore_run=""
  local runs_count=""
  local -a monitor_subcmd=()

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "${1}" in
      run|analyze|status|list-trash|purge|install|uninstall|config|help|version)
        command="${1}"
        shift
        ;;
      monitor)
        command="monitor"
        shift
        # Capture remaining args as monitor subcommand (top/kill/collect/--hours)
        # --dry-run is a global option: honour it here too, so
        # "monitor setup --dry-run" does not install for real
        local monitor_arg
        monitor_subcmd=()
        for monitor_arg in "$@"; do
          if [[ "${monitor_arg}" == "--dry-run" ]]; then
            MAC_OPS_DRY_RUN=true
            MAC_OPS_CLI_OVERRIDES[MAC_OPS_DRY_RUN]=true
          else
            monitor_subcmd+=("${monitor_arg}")
          fi
        done
        set --  # clear positional params to end the while loop
        ;;
      __agent-bin-path)
        # Internal (tests): print the path install would write for <script>
        command="__agent-bin-path"
        shift
        restore_path="${1:-}"
        set --
        ;;
      restore)
        command="restore"
        shift
        # Capture path argument after restore (or --run <run-id>, below)
        if [[ $# -gt 0 && "${1}" != --* ]]; then
          restore_path="${1}"
          shift
        fi
        ;;
      --run)
        # restore --run <run-id> (any position after restore)
        if [[ $# -lt 2 || "${2}" == --* ]]; then
          print -- "[ERROR] --run needs a run ID (see: mac-ops runs)" >&2
          return 1
        fi
        restore_run="${2}"
        shift 2
        ;;
      --run=*)
        restore_run="${1#--run=}"
        shift
        ;;
      runs)
        command="runs"
        shift
        if [[ $# -gt 0 && "${1}" =~ ^[0-9]+$ ]]; then
          runs_count="${1}"
          shift
        fi
        ;;
      --dry-run)
        MAC_OPS_DRY_RUN=true
        MAC_OPS_CLI_OVERRIDES[MAC_OPS_DRY_RUN]=true
        shift
        ;;
      --module=*)
        module_name="${1#--module=}"
        shift
        ;;
      --verbose)
        MAC_OPS_VERBOSE=true
        MAC_OPS_CLI_OVERRIDES[MAC_OPS_VERBOSE]=true
        shift
        ;;
      --force)
        MAC_OPS_FORCE=true
        MAC_OPS_CLI_OVERRIDES[MAC_OPS_FORCE]=true
        shift
        ;;
      --scheduled)
        MAC_OPS_SCHEDULED=true
        shift
        ;;
      --help|-h)
        command="help"
        shift
        ;;
      --version|-v)
        command="version"
        shift
        ;;
      *)
        print -- "[ERROR] Unknown argument: ${1}" >&2
        _mac_ops_show_help
        return 1
        ;;
    esac
  done

  if [[ -n "${restore_run}" && "${command}" != "restore" ]]; then
    print -- "[ERROR] --run is only valid with restore: mac-ops restore --run <run-id>" >&2
    return 1
  fi

  # Execute command
  case "${command}" in
    run)
      _mac_ops_cmd_run "${module_name}"
      ;;
    analyze)
      _mac_ops_cmd_analyze
      ;;
    monitor)
      _mac_ops_cmd_monitor "${monitor_subcmd[@]}"
      ;;
    status)
      _mac_ops_cmd_status
      ;;
    restore)
      _mac_ops_cmd_restore "${restore_path}" "${restore_run}"
      ;;
    runs)
      _mac_ops_cmd_runs "${runs_count}"
      ;;
    list-trash)
      _mac_ops_cmd_list_trash
      ;;
    purge)
      _mac_ops_cmd_purge
      ;;
    __agent-bin-path)
      _mac_ops_agent_bin_path "${restore_path}"
      ;;
    install)
      _mac_ops_cmd_install
      ;;
    uninstall)
      _mac_ops_cmd_uninstall
      ;;
    config)
      _mac_ops_cmd_config
      ;;
    help)
      _mac_ops_show_help
      ;;
    version)
      _mac_ops_show_version
      ;;
  esac
}

# --- Execute ---
_mac_ops_main "$@"
