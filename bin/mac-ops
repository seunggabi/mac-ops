#!/bin/zsh
# =============================================================================
# mac-ops: macOS optimization CLI tool
# Main entry point
# =============================================================================

setopt ERR_EXIT PIPE_FAIL

# --- Ensure system PATH ---
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin"

# --- Root path based on script location ---
MAC_OPS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# --- Module loading ---
source "${MAC_OPS_ROOT}/lib/core/config.zsh"
source "${MAC_OPS_ROOT}/lib/core/logger.zsh"
source "${MAC_OPS_ROOT}/lib/core/lock.zsh"
source "${MAC_OPS_ROOT}/lib/core/trash.zsh"
source "${MAC_OPS_ROOT}/lib/core/safety.zsh"
source "${MAC_OPS_ROOT}/lib/core/ignore.zsh"
source "${MAC_OPS_ROOT}/lib/core/disk.zsh"
source "${MAC_OPS_ROOT}/lib/utils/plist-helper.zsh"
source "${MAC_OPS_ROOT}/lib/utils/format.zsh"
source "${MAC_OPS_ROOT}/lib/utils/parallel.zsh"
source "${MAC_OPS_ROOT}/lib/utils/notify.zsh"
source "${MAC_OPS_ROOT}/lib/utils/snapshot.zsh"
source "${MAC_OPS_ROOT}/lib/modules/cache-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/tmp-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/log-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/zombie-killer.zsh"
source "${MAC_OPS_ROOT}/lib/modules/orphan-killer.zsh"
source "${MAC_OPS_ROOT}/lib/modules/orphan-app-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/brew-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/dev-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/docker-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/browser-cleanup.zsh"
source "${MAC_OPS_ROOT}/lib/modules/analyze.zsh"
source "${MAC_OPS_ROOT}/lib/modules/monitor.zsh"

# --- Version (from git tag or VERSION file) ---
if [[ -d "${MAC_OPS_ROOT}/.git" ]]; then
  # Development mode: use git tag
  MAC_OPS_VERSION=$(git -C "${MAC_OPS_ROOT}" describe --tags --abbrev=0 2>/dev/null || echo "unknown")
  MAC_OPS_VERSION="${MAC_OPS_VERSION#v}"
elif [[ -f "${MAC_OPS_ROOT}/VERSION" ]]; then
  # Installed mode: use VERSION file
  MAC_OPS_VERSION=$(cat "${MAC_OPS_ROOT}/VERSION")
else
  MAC_OPS_VERSION="unknown"
fi

# --- Module name -> function name mapping ---
typeset -A MAC_OPS_MODULE_MAP
MAC_OPS_MODULE_MAP=(
  cache       mac_ops_cache_cleanup
  tmp         mac_ops_tmp_cleanup
  log         mac_ops_log_cleanup
  zombie      mac_ops_zombie_killer
  orphan      mac_ops_orphan_killer
  orphan-app  mac_ops_orphan_app_cleanup
  brew        mac_ops_brew_cleanup
  dev         mac_ops_dev_cleanup
  docker      mac_ops_docker_cleanup
  browser     mac_ops_browser_cleanup
)

# =============================================================================
# Help
# =============================================================================
_mac_ops_show_help() {
  cat <<'HELP'
mac-ops - macOS optimization CLI tool

Usage:
  mac-ops [command] [options]

Commands:
  run              Run cleanup (default command)
  analyze          Disk space analysis report
  monitor          Memory & CPU usage dashboard (7-day history)
  monitor --hours  Show hourly sparkline view
  monitor top [N]  Show top N processes by memory (default: 10)
  monitor kill [M] Kill processes using more than M MB (default: 500)
  monitor collect  Record a snapshot (use for scheduled collection)
  monitor setup    Install launchd agent (collect every 5 min)
  monitor unsetup  Uninstall launchd agent
  status           Show trash status and disk usage
  restore <path>   Restore from trash to original location
  list-trash       List trash contents
  purge            Purge expired trash items immediately
  install          Install launchd agent
  uninstall        Uninstall launchd agent
  config           Show current configuration
  help             Show help
  version          Show version

Options:
  --dry-run        Preview without actual execution
  --module=NAME    Run specific module only
  --verbose        Verbose log output
  --force          Ignore size guard
  --scheduled      Internal flag when run from launchd

Available modules:
  cache, tmp, log, zombie, orphan, orphan-app, brew, dev, docker, browser
HELP
}

# =============================================================================
# version
# =============================================================================
_mac_ops_show_version() {
  print "mac-ops v${MAC_OPS_VERSION}"
}

# =============================================================================
# run command
# =============================================================================
_mac_ops_cmd_run() {
  local target_module="${1:-}"

  # 1. Initialize directories
  mac_ops_init_dirs

  # 2. Load configuration
  mac_ops_load_config

  # 3. Log rotation
  mac_ops_log_rotate

  # 4. Acquire lock - exit on failure
  if ! mac_ops_acquire_lock; then
    mac_ops_log_error "Another mac-ops instance is already running. Exiting."
    return 1
  fi

  # 5. Setup trap
  mac_ops_setup_trap

  # 6. Emergency purge on disk danger
  mac_ops_emergency_purge || true

  # 7. Take before snapshot
  local snapshot_before
  snapshot_before=$(mac_ops_take_snapshot)

  # 8. Initialize global counters
  MAC_OPS_CLEANED_COUNT=0
  MAC_OPS_CLEANED_BYTES=0
  MAC_OPS_KILLED_COUNT=0

  # Temporary directory for statistics collection
  local stats_dir="${MAC_OPS_HOME}/.tmp/stats_$$"
  local mod_count=0 mod_bytes=0
  mkdir -p "${stats_dir}" 2>/dev/null

  # 9. Load user ignore rules (before any module runs)
  mac_ops_ignore_load

  # 10. Module execution
  if [[ -n "${target_module}" ]]; then
    # Run only specified module when --module is given
    if [[ -z "${MAC_OPS_MODULE_MAP[${target_module}]+_}" ]]; then
      mac_ops_log_error "Unknown module: ${target_module}"
      mac_ops_release_lock
      return 1
    fi

    local func="${MAC_OPS_MODULE_MAP[${target_module}]}"
    mac_ops_log_info "Running module: ${target_module} (${func})"
    ${func} || true
  else
    # File cleanup modules: wrap each module to record statistics to file
    local file_modules=(
      mac_ops_cache_cleanup
      mac_ops_tmp_cleanup
      mac_ops_log_cleanup
      mac_ops_orphan_app_cleanup
      mac_ops_brew_cleanup
      mac_ops_dev_cleanup
      mac_ops_docker_cleanup
      mac_ops_browser_cleanup
    )

    mac_ops_log_info "Starting parallel execution of file cleanup modules (timeout: ${MAC_OPS_PARALLEL_TIMEOUT_SECONDS:-300}s per module)"
    local -a pids=()
    for mod_func in "${file_modules[@]}"; do
      (
        MAC_OPS_CLEANED_COUNT=0
        MAC_OPS_CLEANED_BYTES=0
        ${mod_func} || true
        # Record statistics to file
        print "${MAC_OPS_CLEANED_COUNT} ${MAC_OPS_CLEANED_BYTES}" > "${stats_dir}/${mod_func}.stats"
      ) &
      pids+=($!)
    done

    # Wait for all parallel modules to complete with timeout monitoring
    mac_ops_parallel_wait_with_timeout "${MAC_OPS_PARALLEL_TIMEOUT_SECONDS:-300}" "${pids[@]}" || \
      mac_ops_log_warn "Some modules timed out or failed during parallel execution"

    # Sum up from statistics files
    # shellcheck disable=SC1073,SC1036,SC1058,SC1072
    for stats_file in "${stats_dir}"/*.stats(N); do
      [[ ! -f "${stats_file}" ]] && continue
      mod_count=0; mod_bytes=0
      read -r mod_count mod_bytes < "${stats_file}" 2>/dev/null || continue
      MAC_OPS_CLEANED_COUNT=$((MAC_OPS_CLEANED_COUNT + ${mod_count:-0}))
      MAC_OPS_CLEANED_BYTES=$((MAC_OPS_CLEANED_BYTES + ${mod_bytes:-0}))
    done

    # Process modules sequential execution
    mac_ops_log_info "Starting sequential execution of process modules"
    mac_ops_zombie_killer || true
    mac_ops_orphan_killer || true
  fi

  # Cleanup statistics temporary directory (guard: must match expected path pattern)
  [[ -n "${stats_dir}" && "${stats_dir}" == *"/stats_"* ]] && rm -rf "${stats_dir}" 2>/dev/null

  # 9. Delete expired files (72 hour threshold)
  mac_ops_trash_expire || true

  # 10. Release lock
  mac_ops_release_lock

  # 11. Take after snapshot
  local snapshot_after
  snapshot_after=$(mac_ops_take_snapshot)

  # 12. System report (before/after comparison + cleanup summary)
  mac_ops_print_report "${snapshot_before}" "${snapshot_after}" "${MAC_OPS_CLEANED_COUNT}" "${MAC_OPS_CLEANED_BYTES}" "${MAC_OPS_KILLED_COUNT}"

  # 13. macOS notification (scheduled mode)
  local before_disk_pct after_disk_pct
  before_disk_pct="${snapshot_before%% *}"
  after_disk_pct="${snapshot_after%% *}"
  mac_ops_notify_completion "${MAC_OPS_CLEANED_COUNT}" "${MAC_OPS_CLEANED_BYTES}" "${MAC_OPS_KILLED_COUNT}" "${before_disk_pct}" "${after_disk_pct}"
}

# =============================================================================
# status command
# =============================================================================
_mac_ops_cmd_status() {
  mac_ops_init_dirs
  mac_ops_load_config

  # Trash status
  mac_ops_trash_status

  print ""

  # Disk usage
  local disk_usage disk_available
  disk_usage=$(mac_ops_get_disk_usage) || disk_usage="N/A"
  disk_available=$(mac_ops_get_disk_available) || disk_available="0"

  local available_human
  available_human=$(mac_ops_format_bytes "${disk_available}")

  print "=== Disk Status ==="
  print "Usage:           ${disk_usage}%"
  print "Available space: ${available_human}"

  print ""

  # launchd agent status
  print "=== launchd Agent ==="
  if launchctl list 2>/dev/null | grep -q "com.mac-ops" 2>/dev/null; then
    print "Status: Installed (Active)"
  else
    print "Status: Not installed"
  fi
}

# =============================================================================
# restore command
# =============================================================================
_mac_ops_cmd_restore() {
  local restore_path="${1:-}"

  if [[ -z "${restore_path}" ]]; then
    mac_ops_log_error "Usage: mac-ops restore <path>"
    return 1
  fi

  mac_ops_init_dirs
  mac_ops_load_config
  mac_ops_trash_restore "${restore_path}"
}

# =============================================================================
# list-trash command
# =============================================================================
_mac_ops_cmd_list_trash() {
  mac_ops_init_dirs
  mac_ops_load_config
  mac_ops_trash_list
}

# =============================================================================
# purge command
# =============================================================================
_mac_ops_cmd_purge() {
  mac_ops_init_dirs
  mac_ops_load_config
  mac_ops_trash_expire
}

# =============================================================================
# install command
# =============================================================================
_mac_ops_cmd_install() {
  local plist_src="${MAC_OPS_ROOT}/launchd/com.mac-ops.cleanup.plist"
  local plist_dst="${HOME}/Library/LaunchAgents/com.mac-ops.cleanup.plist"
  local bin_path="${MAC_OPS_ROOT}/bin/mac-ops"
  local home_path="${HOME}/.mac-ops"

  if [[ ! -f "${plist_src}" ]]; then
    mac_ops_log_error "plist template not found: ${plist_src}"
    return 1
  fi

  # 1. Ensure LaunchAgents directory
  mkdir -p "${HOME}/Library/LaunchAgents" 2>/dev/null || true

  # 2. Copy plist and replace placeholders
  sed -e "s|REPLACEME_MAC_OPS_BIN|${bin_path}|g" \
      -e "s|REPLACEME_MAC_OPS_HOME|${home_path}|g" \
      "${plist_src}" > "${plist_dst}"

  # 3. launchctl load
  launchctl load "${plist_dst}" 2>/dev/null || true

  mac_ops_log_info "launchd agent installed: ${plist_dst}"

  # 4. FDA permission guide
  print ""
  print "========================================================"
  print " FDA (Full Disk Access) permission is required."
  print ""
  print " System Settings > Privacy & Security > Full Disk Access"
  print " Please add the following item:"
  print ""
  print "   ${bin_path}"
  print ""
  print " Without FDA permission, some cache/log paths cannot be accessed."
  print "========================================================"
}

# =============================================================================
# uninstall command
# =============================================================================
_mac_ops_cmd_uninstall() {
  local plist_path="${HOME}/Library/LaunchAgents/com.mac-ops.cleanup.plist"

  if [[ ! -f "${plist_path}" ]]; then
    mac_ops_log_warn "launchd agent is not installed."
    return 0
  fi

  # 1. launchctl unload
  launchctl unload "${plist_path}" 2>/dev/null || true

  # 2. Delete plist
  rm -f "${plist_path}"

  mac_ops_log_info "launchd agent uninstalled"
}

# =============================================================================
# analyze command
# =============================================================================
_mac_ops_cmd_analyze() {
  mac_ops_init_dirs
  mac_ops_load_config
  mac_ops_analyze
}

# =============================================================================
# monitor command
# =============================================================================
_mac_ops_cmd_monitor() {
  mac_ops_init_dirs
  mac_ops_load_config

  local subcmd="${1:-show}"
  shift 2>/dev/null || true

  case "${subcmd}" in
    show|--hours|-h)
      mac_ops_monitor_show "${subcmd}"
      ;;
    top)
      mac_ops_monitor_top "${1:-10}"
      ;;
    kill)
      mac_ops_monitor_kill "${1:-${MAC_OPS_MONITOR_KILL_THRESHOLD_MB:-500}}"
      ;;
    collect)
      mac_ops_monitor_collect
      mac_ops_log_info "Monitor snapshot collected"
      ;;
    setup)
      local plist_src="${MAC_OPS_ROOT}/launchd/com.mac-ops.monitor.plist"
      local plist_dst="${HOME}/Library/LaunchAgents/com.mac-ops.monitor.plist"
      local bin_path="${MAC_OPS_ROOT}/bin/mac-ops"
      local home_path="${HOME}/.mac-ops"
      if [[ ! -f "${plist_src}" ]]; then
        mac_ops_log_error "plist template not found: ${plist_src}"
        return 1
      fi
      mkdir -p "${HOME}/Library/LaunchAgents" 2>/dev/null || true
      sed -e "s|REPLACEME_MAC_OPS_BIN|${bin_path}|g" \
          -e "s|REPLACEME_MAC_OPS_HOME|${home_path}|g" \
          "${plist_src}" > "${plist_dst}"
      launchctl load "${plist_dst}" 2>/dev/null || true
      mac_ops_log_info "Monitor launchd agent installed (every 5 min): ${plist_dst}"
      ;;
    unsetup)
      local plist_path="${HOME}/Library/LaunchAgents/com.mac-ops.monitor.plist"
      if [[ ! -f "${plist_path}" ]]; then
        mac_ops_log_warn "Monitor launchd agent is not installed."
        return 0
      fi
      launchctl unload "${plist_path}" 2>/dev/null || true
      rm -f "${plist_path}"
      mac_ops_log_info "Monitor launchd agent uninstalled"
      ;;
    *)
      # treat unknown subcommand as flag to show (e.g., --hours passed first)
      mac_ops_monitor_show "${subcmd}"
      ;;
  esac
}

# =============================================================================
# config command
# =============================================================================
_mac_ops_cmd_config() {
  mac_ops_init_dirs
  mac_ops_load_config

  print "=== mac-ops Current Configuration ==="
  print "MAC_OPS_HOME                     = ${MAC_OPS_HOME}"
  print "MAC_OPS_TRASH_DIR                = ${MAC_OPS_TRASH_DIR}"
  print "MAC_OPS_META_DIR                 = ${MAC_OPS_META_DIR}"
  print "MAC_OPS_LOG_DIR                  = ${MAC_OPS_LOG_DIR}"
  print "MAC_OPS_CONFIG_FILE              = ${MAC_OPS_CONFIG_FILE}"
  print "MAC_OPS_DRY_RUN                  = ${MAC_OPS_DRY_RUN}"
  print "MAC_OPS_VERBOSE                  = ${MAC_OPS_VERBOSE}"
  print "MAC_OPS_FORCE                    = ${MAC_OPS_FORCE}"
  print "MAC_OPS_SCHEDULED                = ${MAC_OPS_SCHEDULED}"
  print "MAC_OPS_TRASH_RETENTION_HOURS    = ${MAC_OPS_TRASH_RETENTION_HOURS}"
  print "MAC_OPS_CACHE_MAX_AGE_DAYS       = ${MAC_OPS_CACHE_MAX_AGE_DAYS}"
  print "MAC_OPS_TMP_MAX_AGE_DAYS         = ${MAC_OPS_TMP_MAX_AGE_DAYS}"
  print "MAC_OPS_VAR_FOLDERS_MAX_AGE_DAYS = ${MAC_OPS_VAR_FOLDERS_MAX_AGE_DAYS}"
  print "MAC_OPS_CRASH_MAX_AGE_DAYS       = ${MAC_OPS_CRASH_MAX_AGE_DAYS}"
  print "MAC_OPS_LOG_CLEANUP_MAX_AGE_DAYS = ${MAC_OPS_LOG_CLEANUP_MAX_AGE_DAYS}"
  print "MAC_OPS_DIAG_REPORT_MAX_AGE_DAYS = ${MAC_OPS_DIAG_REPORT_MAX_AGE_DAYS}"
  print "MAC_OPS_ORPHAN_MIN_RUNNING_HOURS = ${MAC_OPS_ORPHAN_MIN_RUNNING_HOURS}"
  print "MAC_OPS_ORPHAN_APP_GRACE_DAYS    = ${MAC_OPS_ORPHAN_APP_GRACE_DAYS}"
}

# =============================================================================
# CLI parsing and main
# =============================================================================
_mac_ops_main() {
  local command="run"
  local module_name=""
  local restore_path=""
  local -a monitor_subcmd=()

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "${1}" in
      run|analyze|status|list-trash|purge|install|uninstall|config|help|version)
        command="${1}"
        shift
        ;;
      monitor)
        command="monitor"
        shift
        # Capture remaining args as monitor subcommand (top/kill/collect/--hours)
        monitor_subcmd=("$@")
        set --  # clear positional params to end the while loop
        ;;
      restore)
        command="restore"
        shift
        # Capture path argument after restore
        if [[ $# -gt 0 && "${1}" != --* ]]; then
          restore_path="${1}"
          shift
        fi
        ;;
      --dry-run)
        MAC_OPS_DRY_RUN=true
        shift
        ;;
      --module=*)
        module_name="${1#--module=}"
        shift
        ;;
      --verbose)
        MAC_OPS_VERBOSE=true
        shift
        ;;
      --force)
        MAC_OPS_FORCE=true
        shift
        ;;
      --scheduled)
        MAC_OPS_SCHEDULED=true
        shift
        ;;
      --help|-h)
        command="help"
        shift
        ;;
      --version|-v)
        command="version"
        shift
        ;;
      *)
        print -- "[ERROR] Unknown argument: ${1}" >&2
        _mac_ops_show_help
        return 1
        ;;
    esac
  done

  # Execute command
  case "${command}" in
    run)
      _mac_ops_cmd_run "${module_name}"
      ;;
    analyze)
      _mac_ops_cmd_analyze
      ;;
    monitor)
      _mac_ops_cmd_monitor "${monitor_subcmd[@]}"
      ;;
    status)
      _mac_ops_cmd_status
      ;;
    restore)
      _mac_ops_cmd_restore "${restore_path}"
      ;;
    list-trash)
      _mac_ops_cmd_list_trash
      ;;
    purge)
      _mac_ops_cmd_purge
      ;;
    install)
      _mac_ops_cmd_install
      ;;
    uninstall)
      _mac_ops_cmd_uninstall
      ;;
    config)
      _mac_ops_cmd_config
      ;;
    help)
      _mac_ops_show_help
      ;;
    version)
      _mac_ops_show_version
      ;;
  esac
}

# --- Execute ---
_mac_ops_main "$@"
